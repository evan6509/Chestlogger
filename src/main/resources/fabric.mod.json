{
  "schemaVersion": 1,
  "id": "chestlogger_csv",
  "version": "${version}",
  "name": "Chest Logger CSV",
  "description": "Logs player container activity and automatic hopper transfers to one searchable CSV per world.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": { "main": ["com.chestlogger.ChestLoggerCsv"] },
  "mixins": ["chestlogger-csv.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": ">=${api_min}",
    "minecraft": "${minecraft}",
    "java": ">=25"
  }
}
